NODE_ENV=development
PORT=3333
HOST=127.0.0.1
DATA_DIR=./data
# Obrigatório em produção (mínimo 32 caracteres). O app desktop gera e guarda um automaticamente.
JWT_SECRET=troque-isto-por-um-segredo-longo-com-32-caracteres-ou-mais
JWT_ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=7
LOG_LEVEL=info
COOKIE_SECURE=false
SWAGGER_ENABLED=true
