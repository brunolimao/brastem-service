{
  "name": "brastem-service",
  "private": true,
  "version": "2.0.0",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:cobertura": "turbo run test:cobertura",
    "typecheck": "turbo run typecheck",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "lefthook": "latest",
    "turbo": "2.11.10",
    "typescript": "latest"
  }
}
