{
  "name": "brastem-service",
  "private": true,
  "version": "2.0.0",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24 <25"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:cobertura": "turbo run test:cobertura",
    "typecheck": "turbo run typecheck",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "regras": "node scripts/conferir-regras.mjs",
    "sem-uso": "knip --no-progress",
    "semear": "node scripts/semear.mjs",
    "test:scripts": "node --test \"scripts/*.test.mjs\""
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "knip": "^6.43.0",
    "lefthook": "^2.2.2",
    "turbo": "2.11.10",
    "typescript": "^7.0.2"
  }
}
